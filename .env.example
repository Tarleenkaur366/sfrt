# Smart Financial Reporting Tool (SFRT) Configuration

# Environment mode: development, testing, or production
ENVIRONMENT=development

# Database configuration:
# For MySQL (INA database):
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/INA
# Fallback local database for immediate standalone zero-configuration run:
DATABASE_URL=sqlite:///./sfrt.db

# Security & Sessions
SECRET_KEY=replace-with-a-very-secure-random-secret-key-in-production-32-chars-min
ALGORITHM=HS256
SESSION_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Application settings
APP_NAME="Smart Financial Reporting Tool"
DEFAULT_CURRENCY=INR
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=100
